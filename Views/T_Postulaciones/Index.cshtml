@model IEnumerable<StudentJobsCR.Models.T_Postulaciones>

@{
    ViewBag.Title = "Postulaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Postulaciones</h2>

<p>
    @Html.ActionLink("Crear nueva postulacion", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FechaPostulacion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Estado_Postulacion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nota_Postulacion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.T_Estudiantes.Cedula_Estudiante)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.T_Vacantes.Titulo_Vacante)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.FechaPostulacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Estado_Postulacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nota_Postulacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.T_Estudiantes.Cedula_Estudiante)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.T_Vacantes.Titulo_Vacante)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.Id_Postulacion }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.Id_Postulacion }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.Id_Postulacion })
        </td>
    </tr>
}

</table>
