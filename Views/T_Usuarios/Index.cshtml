@model IEnumerable<StudentJobsCR.Models.T_Usuarios>

@{
    ViewBag.Title = "Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Usuarios</h2>

<p>
    @Html.ActionLink("Crear nuevo usuario", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Cedula_Usuario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre_Usuario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email_Usuario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Password_Usuario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Rol_Usuario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaRegistro_Usuario)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Cedula_Usuario)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre_Usuario)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Email_Usuario)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Password_Usuario)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Rol_Usuario)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaRegistro_Usuario)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.Id_Usuario }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.Id_Usuario }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.Id_Usuario })
        </td>
    </tr>
}

</table>
