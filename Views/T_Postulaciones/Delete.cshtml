@model StudentJobsCR.Models.T_Postulaciones

@{
    ViewBag.Title = "Eliminar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar</h2>

<h3>Estas seguro que quieres eliminar la postulacion?</h3>
<div>
    <h4>Postulaciones</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.FechaPostulacion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FechaPostulacion)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Estado_Postulacion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Estado_Postulacion)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Nota_Postulacion)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nota_Postulacion)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.T_Estudiantes.Cedula_Estudiante)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.T_Estudiantes.Cedula_Estudiante)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.T_Vacantes.Titulo_Vacante)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.T_Vacantes.Titulo_Vacante)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-default" /> |
            @Html.ActionLink("Devuelta a la lista", "Index")
        </div>
    }
</div>
