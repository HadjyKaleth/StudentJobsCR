@model StudentJobsCR.Models.RegistroViewModel

@{
    ViewBag.Title = "Registro de Usuario";
}

<h2>Crear Cuenta</h2>

@using (Html.BeginForm("Registro", "Auth", FormMethod.Post))
{
    <p style="color:red">@ViewBag.Error</p>
    <div class="form-group">
        <label>Cedula</label>
        @Html.TextBoxFor(m => m.Cedula_Usuario, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group">
        <label>Nombre</label>
        @Html.TextBoxFor(m => m.Nombre_Usuario, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group">
        <label>Correo Electronico</label>
        @Html.TextBoxFor(m => m.Email_Usuario, new { @class = "form-control", type = "email", required = "required" })
    </div>
    <div class="form-group">
        <label>Contrasena</label>
        @Html.PasswordFor(m => m.Password_Usuario, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group">
        <label>Rol</label>
        @Html.TextBoxFor(m => m.Rol_Usuario, new { @class = "form-control", placeholder = "Admin, Empresa o Estudiante" })
    </div>
    <button type="submit" class="btn">Registrarse</button>
}